# Public product name shown in the header and metadata.
NEXT_PUBLIC_SITE_NAME=Melody Studio

# --- RunningHub (default provider) ---
# Numeric ID from the published RunningHub AI App URL: /ai-detail/<id>
RUNNINGHUB_WEBAPP_ID=

# Defaults to the mainland RunningHub deployment.
RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# --- Replicate (optional) ---
# Model ref: owner/name or owner/name:version
# REPLICATE_MODEL=
# Optional JSON: logical field -> Replicate input field, e.g. {"prompt":"prompt","duration":"duration"}
# REPLICATE_INPUT_MAP=

# --- fal.ai (optional) ---
# Model ref: e.g. fal-ai/stable-audio
# FAL_MODEL=
# Optional JSON mapping like REPLICATE_INPUT_MAP
# FAL_INPUT_MAP=

# --- OpenAI-compatible audio (optional) ---
# Origin only, e.g. https://api.openai.com
# OPENAI_AUDIO_BASE_URL=
# Defaults to gpt-4o-mini-tts
# OPENAI_AUDIO_MODEL=
# Optional JSON mapping like REPLICATE_INPUT_MAP
# OPENAI_AUDIO_INPUT_MAP=

# Optional: only for a local upstream mock. Never enable in production.
# RH_ALLOW_LOCAL_MOCK=1
